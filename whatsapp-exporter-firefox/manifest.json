{
  "manifest_version": 2,
  "name": "WhatsApp Chat Exporter",
  "version": "1.2.0",
  "description": "Export WhatsApp Web chats to TXT, HTML, JSON or CSV. Everything stays on your computer.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "*://web.whatsapp.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Export WhatsApp chat",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp-chat-exporter@diplomatool",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
